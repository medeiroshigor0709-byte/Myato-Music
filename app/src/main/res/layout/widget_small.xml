<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_small"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_dark"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/widget_cover"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/cd_album_cover"
        android:scaleType="centerCrop"
        android:src="@drawable/img_default_album_art" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="MYATO MUSIC"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/widget_btn_play_pause"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_widget_orange_circle"
        android:contentDescription="@string/cd_play_pause"
        android:src="@android:drawable/ic_media_play"
        android:tint="#FF000000" />
</LinearLayout>
